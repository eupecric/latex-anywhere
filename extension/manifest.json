{
  "manifest_version": 3,
  "name": "LaTeX Anywhere — Editor & Preview",
  "short_name": "LaTeX Anywhere",
  "description": "Editor de LaTeX e Markdown com atalhos, minimização e ocultação por aba, domínio ou global.",
  "version": "1.10.3",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "vendor/katex-local.js",
        "vendor/marked.js",
        "vendor/markdown-renderer.js",
        "vendor/latex-formatting.js",
        "vendor/latex-catalog.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LaTeX Anywhere — ocultar ou minimizar por aba, domínio ou em todos os sites",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-latex-anywhere": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Reativar ocultação global, de domínio ou da aba atual"
    }
  }
}
